@using WebApp.Presentation.ViewModels
@model DepartmentCreateViewModel
@{
    ViewData[index: "Title"] = "部署登録(確認)";
}

<h2 class="text-center mt-4">@ViewData[index: "Title"]</h2>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-sm-8">
            <table class="table table-hover">
                <tbody>
                    <tr>
                        <td class="fw-bold">@Html.DisplayNameFor(m => m.DepartmentName)</td>
                        <td>@Html.DisplayFor(m => m.DepartmentName)</td>
                    </tr>
                </tbody>
            </table>

            <form>
                <input type="hidden" asp-for="DepartmentName" />
                <div class="text-center mt-4">
                    <button type="submit"
                            formaction="@Url.Action(action: "CreateExecute", controller: "DepartmentCreate")"
                            formmethod="post" class="btn btn-primary">登録</button>
                    <button type="submit"
                            formaction="@Url.Action(action: "CreateBack", controller: "DepartmentCreate")"
                            formmethod="post" class="btn btn-secondary">戻る</button>
                </div>
            </form>
        </div>
    </div>
</div>
