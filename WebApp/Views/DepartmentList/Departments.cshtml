@using WebApp.Presentation.ViewModels
@model DepartmentListViewModel
@{
    ViewData[index: "Title"] = "部署一覧";
}

<h2 class="text-center mt-4">@ViewData[index: "Title"]</h2>

<div class="container mt-4">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>部署ID</th>
                <th>部署名</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (DepartmentListItemViewModel department in Model.Departments)
            {
                <tr>
                    <td>@department.DepartmentId</td>
                    <td>@department.DepartmentName</td>
                    <td>
                        <form asp-action="DeleteConfirm" asp-controller="DepartmentDelete" method="post" class="d-inline">
                            <input type="hidden" name="DepartmentId" value="@department.DepartmentId" />
                            <input type="hidden" name="DepartmentName" value="@department.DepartmentName" />
                            <button type="submit" class="btn btn-danger btn-sm">削除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
