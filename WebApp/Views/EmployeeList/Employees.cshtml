@using WebApp.Presentation.ViewModels
@model EmployeeListViewModel
@{
    ViewData[index: "Title"] = "従業員一覧";
}

<h2 class="text-center mt-4">@ViewData[index: "Title"]</h2>

<div class="container mt-4">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>従業員ID</th>
                <th>氏名</th>
                <th>メールアドレス</th>
                <th>電話番号</th>
                <th>部署ID</th>
                <th>部署名</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (EmployeeListItemViewModel employee in Model.Employees)
            {
                <tr>
                    <td>@employee.EmployeeId</td>
                    <td>@employee.EmployeeName</td>
                    <td>@employee.Email</td>
                    <td>@employee.Phone</td>
                    <td>@employee.DepartmentId</td>
                    <td>@employee.DepartmentName</td>
                    <td>
                        <form asp-action="DeleteConfirm" asp-controller="EmployeeDelete" method="post" class="d-inline">
                            <input type="hidden" name="EmployeeId" value="@employee.EmployeeId" />
                            <input type="hidden" name="EmployeeName" value="@employee.EmployeeName" />
                            <input type="hidden" name="EmployeeEmail" value="@employee.Email" />
                            <input type="hidden" name="EmployeePhone" value="@employee.Phone" />
                            <input type="hidden" name="DepartmentName" value="@employee.DepartmentName" />
                            <button type="submit" class="btn btn-danger btn-sm">削除</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
